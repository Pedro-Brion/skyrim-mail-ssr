{
  "name": "skyrim-mail-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx ./server/index --watch",
    "build": "pnpm build:client && pnpm build:server && pnpm build:express",
    "build:client": "vue-tsc --noEmit && vite build --outDir dist/client",
    "build:server": "vue-tsc --noEmit && vite build --ssr src/entry-server.ts --outDir dist/server",
    "build:express": "tsc -p tsconfig.node.json",
    "preview": "cross-env NODE_ENV=production node dist/server"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "axios": "^1.21.1",
    "compression": "^1.8.2",
    "devalue": "^6.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "pinia": "^3.0.4",
    "sirv": "^3.0.2",
    "tailwindcss": "^4.3.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "vue": "^3.5.45",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.7.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^16.5.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.2",
    "unplugin-auto-import": "^19.3.0",
    "vite": "^7.3.8",
    "vue-tsc": "^2.2.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild"
    ]
  }
}
